# Google Cloud Service Account Credentials File Path
GOOGLE_APPLICATION_CREDENTIALS=config/service_account.json

# Optional: Specific Google Drive Folder ID to store personal_notes.xlsx
# If empty, saves to the root of the Service Account Drive
GOOGLE_DRIVE_FOLDER_ID=

# Firebase Web API Key (found in Firebase Console > Project Settings > General > Web API Key)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Admin Service Account (can also use config/service_account.json)
FIREBASE_SERVICE_ACCOUNT=config/service_account.json

